# ─── NeoStats-hosted LLM (Azure OpenAI-compatible) ───────────────────────────
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://neo-hackathon.services.ai.azure.com/openai/v1/
OPENAI_DEPLOYMENT=Neo-Hackathon
OPENAI_MODEL=gpt-oss-120b

# ─── Optional overrides ───────────────────────────────────────────────────────
# DB_PATH=data/source/ridewise.db
# DOCS_SOURCE_DIR=documents/source
# DOCS_PROCESSED_DIR=documents/processed
# VECTOR_INDEX_DIR=data/processed/faiss_index
# BM25_INDEX_PATH=data/processed/bm25_index.pkl
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# TOP_K=6
# LLM_TIMEOUT=30
